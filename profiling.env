LD_PRELOAD=/opt/datadog-packages/datadog-apm-inject/stable/inject/launcher.preload.so
DD_INJECT_SENDER_TYPE=k8s
DD_INSTRUMENTATION_INSTALL_TYPE=k8s_lib_injection
DD_SERVICE=dd-arm64-repro
DD_ENV=local
DD_PROFILING_ENABLED=1
DD_INTERNAL_PROFILING_ENABLED_ARM64=1
DD_PROFILING_ALLOCATION_ENABLED=true
DD_TRACE_ENABLED=false
DD_APM_TRACING_ENABLED=false
DD_INSTRUMENTATION_TELEMETRY_ENABLED=false
DD_APPSEC_ENABLED=false
DOTNET_DbgEnableMiniDump=1
DOTNET_DbgMiniDumpType=4
DOTNET_DbgMiniDumpName=/dumps/core.%p
DD_INTERNAL_CRASHTRACKING_OUTPUT=/dumps/crash-report.json
DD_TRACE_LOG_DIRECTORY=/dumps/logs
